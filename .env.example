# ============================================
# AI Agent Sandbox - Environment Variables
# Copy to .env and customize as needed
# ============================================

# =====================================================
# LLM CONNECTIVITY (Required)
# Both agents use OpenAI-compatible REST endpoints by default
# =====================================================

# Base URL for the local LLM server (OpenAI API format)
# Examples:
#   - Ollama: http://host.docker.internal:11434/v1
#   - LM Studio: http://host.docker.internal:1234/v1
#   - vLLM: http://localhost:8000/v1
#   - llama.cpp (OpenAI compat): http://localhost:11434/v1
OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# API Key for the LLM server (if required)
# Most local servers use empty string or special values:
#   - Ollama: "ollama" (empty is fine too)
#   - LM Studio: leave empty or use default token
OPENAI_API_KEY=ollama

# =====================================================
# MODEL SELECTION
# ==============================================

# Default model to use when running agents interactively
# Update this based on your local LLM setup
AGENT_MODEL=llama3.2

# =====================================================
# WEB TERMINAL (Optional)
# Enable ttyd web UI for container access
# =====================================================

# Set to "true" or "1" to enable the web terminal
ENABLE_WEB_TERMINAL=false

# Port for the web terminal (default: 7681, change if needed)
WEB_TERMINAL_PORT=7681

# =====================================================
# AGENT CONFIGURATION
# =====================================================

# PI Agent default command (override from entrypoint.sh defaults)
PI_COMMAND="pi --help"

# OpenCode agent default behavior
OPENCODE_INTERACTIVE=false

# Default shell for interactive sessions
DEFAULT_SHELL=bash

# =====================================================
# LOGGING & DEBUGGING
# =====================================================

# Enable verbose logging during startup
VERBOSE=true

# Log level (debug, info, warn, error)
LOG_LEVEL=info
